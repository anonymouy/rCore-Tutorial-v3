<mxfile host="app.diagrams.net">
  <diagram name="Bypass Architecture" id="bypass-arch">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== Layer boxes ==================== -->

        <mxCell id="layer_user" value="用户态" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#000000;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1020" height="130" as="geometry" />
        </mxCell>

        <mxCell id="layer_kernel" value="内核态" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#000000;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="1020" height="250" as="geometry" />
        </mxCell>

        <mxCell id="layer_device" value="VirtIO 设备 (QEMU)" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#000000;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1020" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== User layer ==================== -->

        <mxCell id="user_proc" value="用户进程&#xa;（构造帧并读写共享缓冲区）" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=18;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="user_syscall" value="sys_net_bypass_tx&#xa;sys_net_bypass_rx" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontColor=#000000;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ua_syscall" value="刷新发送 / 阻塞接收" style="endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontStyle=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="97" as="sourcePoint" />
            <mxPoint x="760" y="97" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Shared memory ==================== -->

        <mxCell id="shm_box" value="" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="225" width="740" height="85" as="geometry" />
        </mxCell>

        <mxCell id="shm_label" value="共享物理页（用户态与内核态映射同一物理内存）" style="text;fontSize=16;fontColor=#000000;align=center;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="190" y="227" width="580" height="22" as="geometry" />
        </mxCell>

        <mxCell id="shm_hdr" value="Header" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="160" y="258" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="shm_tx" value="TX Ring (16 x 2048B)" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="310" y="258" width="250" height="40" as="geometry" />
        </mxCell>

        <mxCell id="shm_rx" value="RX Ring (16 x 2048B)" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="590" y="258" width="250" height="40" as="geometry" />
        </mxCell>

        <!-- arrow: user <-> shared mem (no syscall) -->
        <mxCell id="a_user_shm" value="直接读写&#xa;（无系统调用）" style="endArrow=classic;startArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontStyle=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="130" as="sourcePoint" />
            <mxPoint x="350" y="225" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- arrow: syscall -> kernel -->
        <mxCell id="a_ecall" value="ecall" style="endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontStyle=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="885" y="125" as="sourcePoint" />
            <mxPoint x="885" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Kernel contents ==================== -->

        <mxCell id="k_bypass" value="bypass_tx() / bypass_rx()" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontColor=#000000;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="100" y="345" width="310" height="50" as="geometry" />
        </mxCell>

        <mxCell id="k_netdev" value="NET_DEVICE&#xa;(VirtIONetWrapper)" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="480" y="345" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="k_virtq" value="VirtQueue&#xa;(desc / avail / used)" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="770" y="345" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- kernel arrows -->
        <mxCell id="ka1" value="transmit / receive" style="endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontStyle=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="370" as="sourcePoint" />
            <mxPoint x="480" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="ka2" value="add / pop_used" style="endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontStyle=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="370" as="sourcePoint" />
            <mxPoint x="770" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- arrow: kernel bypass <-> shared mem -->
        <mxCell id="a_k_shm" value="" style="endArrow=classic;startArrow=classic;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="255" y="310" as="sourcePoint" />
            <mxPoint x="255" y="345" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Device contents ==================== -->

        <mxCell id="d_engine" value="网络包收发引擎" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=18;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="300" y="505" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d_dma" value="DMA 读写共享页" style="shape=rectangle;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=18;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="660" y="505" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="da1" value="" style="endArrow=classic;startArrow=classic;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="530" as="sourcePoint" />
            <mxPoint x="660" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- arrow: VirtQueue <-> Device -->
        <mxCell id="a_vq_dev" value="MMIO notify /&#xa;avail &amp; used ring" style="endArrow=classic;startArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontStyle=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="395" as="sourcePoint" />
            <mxPoint x="890" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
